def _when(stamp):
    """Время записи (UTC) для таблицы: 2026-10-04T12:00:00Z -> 2026-10-04 12:00:00."""
    return str(stamp).replace("T", " ").replace("Z", "") if stamp else "—"


def _table(head, rows):
    """Строки таблицы: каждый столбец, кроме последнего, по ширине самой длинной ячейки."""
    cells = [head] + rows
    width = [max(len(r[i]) for r in cells) for i in range(len(head) - 1)]
    return ["  ".join(c.ljust(w) for c, w in zip(r, width)) + "  " + r[-1] for r in cells]


