    ps.add_argument("--json", action="store_true", help="вывод для программ")
    ps.set_defaults(fn=preview_setup)

    pm = sub.add_parser("perms", help="права на файлы архива").add_subparsers(dest="action", required=True)
    for name, fn, text in (("check", perms_check, "проверить, закрыт ли архив от других пользователей"),
                           ("fix", perms_fix, "закрыть: 700 на каталогах, 600 на файлах")):
        one = pm.add_parser(name, help=text)
