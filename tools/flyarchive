    names, roots = s.get("service_names") or [], s.get("service_root_names") or []
    if not names and not roots:
        return "Служебные имена файлов: не заданы, по имени ничего не пропускается."
    parts = [f"{where} — {', '.join(items)}" for where, items in (("в любой папке", names), ("только в корне", roots)) if items]
