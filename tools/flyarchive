def local_time(ts):
    """Время записи журнала (UTC) в поясе этой машины."""
    try:
        return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ"))))
    except (TypeError, ValueError):
        return str(ts)


def state(row, now):
    if row["revoked"]:
        return "отозван " + row["revoked"][:10]
    if row["expires"] and row["expires"] <= now:
        return "просрочен"
    return "действует"


def audit(guard, tool, params, error=None):
    """Выпуск и отзыв токена — в журнал: кто получил доступ к архиву и когда его лишился."""
    guard.journal.write(server="cli", client="владелец", tool=tool, params=params, status=1 if error else 0,
                        outcome=f"отказ: {error}" if error else "ok", ms=0)


def emit(data):
    """Вывод для программ: раздел «Архив» в DSH читает его как JSON."""
    print(json.dumps(data, ensure_ascii=False))


def token_add(guard, a):
    params = {"name": a.name, "level": a.level, "days": a.days}
    try:
        token = guard.store.issue(a.name, a.level, a.days)
    except tokens.TokenError as e:
        audit(guard, "token add", params, e)
        raise
    audit(guard, "token add", params)
    if a.json:
        row = [r for r in guard.store.list() if r["name"] == a.name and not r["revoked"]][-1]
        return emit({"name": a.name, "level": a.level, "token": token, "expires": row["expires"]})
    print(f"Токен клиента «{a.name}», уровень {a.level}:")
    print(token)
    print("Сохрани его сейчас: второй раз он не показывается.")


def token_list(guard, a):
    rows = guard.store.list()
    now = tokens.stamp(guard.clock())
    if a.json:
        return emit([{**r, "state": state(r, now).split()[0]} for r in rows])
    if not rows:
        print("Токенов нет.")
        return
    table = [("имя", "уровень", "выпущен", "срок", "последний вызов", "состояние")]
    for r in rows:
        table.append((r["name"], r["level"], r["created"][:10], (r["expires"] or "без срока")[:10],
                      local_time(r["last_used"]) if r["last_used"] else "не было", state(r, now)))
    widths = [max(len(row[i]) for row in table) for i in range(len(table[0]))]
    for row in table:
        print("  ".join(cell.ljust(w) for cell, w in zip(row, widths)).rstrip())


def token_revoke(guard, a):
    try:
        guard.store.revoke(a.name)
    except tokens.TokenError as e:
        audit(guard, "token revoke", {"name": a.name}, e)
        raise
    audit(guard, "token revoke", {"name": a.name})
    if a.json:
        return emit({"name": a.name, "revoked": True})
    print(f"Токен «{a.name}» отозван. Следующий запрос с ним получит отказ.")


def local_token(guard, touch=True):
    """Служебный токен локального DSH лежит в закрытом файле; запускалка DSH читает его сама. Готовый, годный токен не трогается.
    Возвращает (путь к файлу, выпущен ли токен сейчас). Права на секреты и хранилище проверяются здесь же: отказ один для всех, кто зовёт.
    touch=False — проверка готового токена не отмечается как его вызов (хранилище при этом не пишется)."""
    guard.startup_check()
    path = os.path.join(guard.secrets, "local.token")
    if os.path.exists(path):
        if stat.S_IMODE(os.stat(path).st_mode) & 0o077:
            raise auth.AuthError(messages.make("cli.local_token_open", path=path))
        with open(path, encoding="utf-8") as f:
            client = guard.store.verify(f.read().strip(), touch=touch)
        if client and client.name == LOCAL_NAME and client.level == "local":
            return path, False
    if any(r["name"] == LOCAL_NAME and not r["revoked"] for r in guard.store.list()):
        guard.store.revoke(LOCAL_NAME)
    token = guard.store.issue(LOCAL_NAME, "local")
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(token + "\n")
    os.replace(path + ".tmp", path)
    return path, True


def token_init_local(guard, a):
    path, issued = local_token(guard)
    if not issued:
        print(f"Служебный токен на месте: {path}")
        return
    print(f"Служебный токен локального DSH выпущен и записан в {path}")
    print("Перезапусти DSH, чтобы он его подхватил.")


def _dir_step(path):
    """Каталог с правами владельца; готовый не трогается, права на нём не правятся. Возвращает (создан ли, сообщение)."""
    if os.path.isdir(path):
        return False, messages.make("init.dir_exists", path=path)
    os.makedirs(path, mode=0o700, exist_ok=True)
    return True, messages.make("init.dir_created", path=path)


def _token_step(guard):
    path, issued = local_token(guard, touch=False)
    if issued:
        return True, messages.make("init.token_created", path=path)
    return False, messages.make("init.token_exists", path=path)


def _known_step(home):
    """Пустая база сверки — то же, что `known build` на пустом корпусе; если в корпусе уже есть файлы, база строится по ним, а не пустой."""
    import known
    db = os.path.join(home, "index", "known.sqlite")
    if os.path.exists(db):
        return False, messages.make("init.known_exists", path=db)
    known.build(corpus=os.path.join(home, "corpus"), db=db, jobs=min(16, os.cpu_count() or 1),
                progress=lambda n, total: print(f"прочитано {n} из {total}", file=sys.stderr, flush=True))
    return True, messages.make("init.known_created", path=db)


def _table_step(home):
    import ingest
    folder = ingest.index_dir(home)
    if ingest.create_table(home):
        return True, messages.make("init.table_created", path=folder, dim=ingest.DIM)
    return False, messages.make("init.table_exists", path=folder)


def _owner_todo(home):
    """Что владельцу остаётся сделать самому: только то, что на самом деле ещё не настроено. [(id, сообщение)]."""
    import preview_container
    todo = []
    if preview_container.image(home) is None:
        todo.append(("preview", messages.make("init.todo_preview")))
    if not _SETTINGS["llm_local_model"]:
        todo.append(("model", messages.make("init.todo_model")))
    if not os.path.exists(os.path.join(home, "inbox.json")):
        todo.append(("inbox", messages.make("init.todo_inbox")))
    return todo


def init_steps(guard, report=None):
    """Готовит каталог архива к работе (FR-103): каталоги с правами владельца, служебный токен, пустая база сверки, пустая таблица индекса.
    Каждый шаг — «создано» или «уже есть»: готовое не пересоздаётся и не меняется, таблица индекса с документами не открывается вовсе.
    Права на секреты и хранилище токенов проверяются так же, как у `token init-local`: отказ тот же. Сбой шага — init.step_failed.
    report(сообщение) зовётся после каждого шага. Возвращает (шаги, что осталось владельцу). Тот же код зовёт `flyarchive install`."""
    home = tokens.HOME
    steps = []

    def run(id_, step, *args):
        try:
            created, message = step(*args)
        except messages.CodedError:
            raise                                   # отказ с кодом (права, настройки): как у соседних команд
        except Exception as e:
            raise auth.AuthError(messages.make("init.step_failed", what=id_, why=f"{type(e).__name__}: {e}"[:200]))
        steps.append({"id": id_, "result": "created" if created else "exists", "message": message})
        if report:
            report(message)

    run("home", _dir_step, home)
    run("secrets", _dir_step, os.path.join(home, "secrets"))
    run("token", _token_step, guard)
    for name in ("logs", "index", "corpus"):
        run(name, _dir_step, os.path.join(home, name))
    run("known", _known_step, home)
    run("table", _table_step, home)
    return steps, _owner_todo(home)


def init_archive(guard, a):
    """Команда `flyarchive init`: шаги init_steps, что сделано и что осталось сделать руками."""
    home = tokens.HOME
    if not a.json:
        print(f"Каталог архива: {home}")
    steps, todo = init_steps(guard, None if a.json else lambda message: print(f"  {message}", flush=True))
    if a.json:
        return emit({"home": home, "steps": [{**s, "message": s["message"].to_json()} for s in steps],
                     "todo": [{"id": id_, "message": m.to_json()} for id_, m in todo]})
    if not todo:
        print("Архив готов к работе: осталось положить файлы во входящую папку.")
    else:
        print("Осталось сделать самому:")
        for _, message in todo:
            print(f"  {message}")
    import doctor
    print(doctor.tail(doctor.collect(_SETTINGS, notify=doctor.say_waiting)))     # чего обязательного не хватает: из той же проверки, что `flyarchive doctor`


def doctor_check(guard, a):
