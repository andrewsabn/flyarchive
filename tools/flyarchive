def install_system(guard, a):
    """Команда `flyarchive install` (FR-104): архив (тот же init), службы и таймер из шаблонов, плагин, файл настройки оболочки, запуск. Код — в install.py."""
    import install
    return install.run(a, init=lambda report: init_steps(guard, report))


MINUTE_WORDS = ("одну", "две", "три", "четыре", "пять", "шесть", "семь", "восемь", "девять", "десять")


def plural(n, forms):
    """Форма слова при числе n: (1 минуту, 2 минуты, 5 минут)."""
    if n % 10 == 1 and n % 100 != 11:
        return forms[0]
    if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14:
        return forms[1]
    return forms[2]


def lasts(seconds):
    """Срок для фразы «действует …»: целые минуты — минутами (до десяти — словом), остальное — секундами."""
    if seconds % 60 == 0:
        minutes = seconds // 60
        number = MINUTE_WORDS[minutes - 1] if minutes <= len(MINUTE_WORDS) else str(minutes)
        return f"{number} {plural(minutes, ('минуту', 'минуты', 'минут'))}"
    return f"{seconds} {plural(seconds, ('секунду', 'секунды', 'секунд'))}"


