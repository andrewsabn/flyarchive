def inbox_batch(guard, a):
    """Одна пачка: что с каждым файлом и где он сейчас (FR-70)."""
    import batches
    import intake
    import inbox
    try:
        d = batches.batch_detail(tokens.HOME, a.id)
    except batches.BatchError as e:
        raise auth.AuthError(messages.of(e))
    for f in d["files"]:            # квитанция пишется до описания и не меняется: живое состояние описания берётся из его файла и долгов (FR-92)
        # по отпечатку документа, а не по отметке в квитанции: документ мог проиндексироваться позже, из долгов. Дубликату
        # (пути в корпусе нет) состояние описания чужого документа не показывается
        if isinstance(f.get("sha256"), str) and (isinstance(f.get("vision"), dict) or isinstance(f.get("path"), str)):
            live = inbox.vision_state(tokens.HOME, f["sha256"], f.get("path"))
            if live is not None:
                f["vision"] = live
    if a.json:
        return emit(d)
    took = "—" if d["seconds"] is None else f"{d['seconds']} с"
    print(f"Пачка {d['id']}: {_when(d['time'])} UTC, длительность {took}, файлов {len(d['files'])}, замечаний {len(d['problems'])}.")
    for p in d["problems"]:
        print(f"  замечание: {p.get('text')}")
    rows = []
    for f in d["files"]:
        said = f"; решение владельца: {DECIDED.get(f['decided'], f['decided'])}, {_when(f['decided_at'])}" if f["decided"] else ""
        if isinstance(f.get("vision"), dict):
            said += "; описан моделью, страниц: %s" % f["vision"].get("pages") if f["vision"].get("state") == "described" else "; ждёт описания"
        rows.append([str(f.get("name")), intake.TITLES.get(f.get("decision"), str(f.get("decision"))), str(f.get("score")),
                     WHERE.get(f["location"], str(f["location"])) + said])
    for line in _table(["Файл", "Приёмка", "Баллы", "Где сейчас"], rows):
        print(line)


def _vision_limit(value, required):
    """--limit команд vision: целое от 1 до предела. Нет ключа: у backfill это отказ (старое описывается только порциями), у run — без предела."""
    import inbox
    if value is None:
        if required:
            raise inbox.InboxError(messages.make("vision.limit_needed"))
        return None
    if not re.fullmatch(r"[0-9]{1,6}", str(value)) or not 1 <= int(value) <= inbox.VISION_MAX_LIMIT:
        raise inbox.InboxError(messages.make("vision.bad_limit", max=inbox.VISION_MAX_LIMIT))
    return int(value)


def vision_run(guard, a):
    """Отдать долги «ждёт описания» сейчас, не дожидаясь прохода. Модель — только локальная; настройка vision не спрашивается: команду зовёт владелец.
    Пределы страниц и минут — из настройки, --limit — сколько документов. Модель недоступна — не ошибка: долги остаются, причина в замечании."""
    import inbox
    import vision
    home = tokens.HOME
    cfg = inbox.load_config(home)
    limit = _vision_limit(a.limit, required=False)
    run = inbox.hand_out_vision(home, vision.from_env(), pages=cfg["vision_pages"], minutes=cfg["vision_minutes"], limit=limit)
    if a.json:
        return emit({"documents": run.documents, "pages": run.pages, "waiting": run.waiting, "busy": run.busy,
                     "stopped": run.stopped.to_json() if run.stopped else None, "problems": [p.to_json() for p in run.problems]})
    if run.busy:
        print("Описание уже идёт — этот запуск пропущен.")
        return 0
    for p in run.problems:
        print(f"замечание: {p}", file=sys.stderr)
    if not run.documents and not run.waiting and not run.problems:
        print("Описывать нечего: долгов описания нет.")
        return 0
    print(f"Описано документов: {run.documents}, страниц: {run.pages}. Ждёт описания: {run.waiting}.")
    return 0


