def _batch(a, act):
    """{"results": [...]}: решение act(review, путь) по каждому пути команды; отказ всего списка — до первого действия."""
    import review
    try:
        return review.decide_many(a.paths, lambda path: act(review, path))
    except review.ReviewError as e:
        raise auth.AuthError(messages.of(e))


def _decide(a, act, say):
    """Решение по путям команды. С --json и «--» перед путями (или с несколькими путями) ответ — {"results": [...]} и код возврата 0,
    даже если какой-то путь не удался. Один путь без «--» — прежний ответ и прежний отказ. Без --json несколько путей —
    по строке на путь, сбой — строкой в stderr и код возврата 1. say(ответ) — строка для человека."""
    import review
    if a.json and (a.dashdash or len(a.paths) > 1):
        return emit(_batch(a, act))
    if len(a.paths) == 1:
        try:
            r = act(review, a.paths[0])
        except review.ReviewError as e:
            raise auth.AuthError(messages.of(e))
        return emit(r) if a.json else print(say(r))
    failed = 0
    for row in _batch(a, act)["results"]:
        if row["ok"]:
            print(say({**{k: v for k, v in row.items() if k not in ("path", "ok", "to")}, **({"path": row["to"]} if "to" in row else {})}))
        else:
            failed += 1
            print(f"ошибка: {row['path']}: {row['error']['text']}", file=sys.stderr)
    return 1 if failed else 0


def queue_accept(guard, a):
    """Принять документы из очереди. С --defer-index индексацию команда не ждёт: долг записан, разбор запускает служба, один раз на команду.
    Нет службы или разбор уже идёт — не ошибка: долг уйдёт со следующим проходом."""
    taken, noted = [], set()

    def act(r, path):
        done = r.queue_accept(tokens.HOME, path, defer_index=a.defer_index)
        taken.append(path)
        for note in done.get("notes", ()):                     # письмо принято, а читать его нечем (нет библиотеки): причина названа один раз за команду
            if not a.json and note["text"] not in noted:
                noted.add(note["text"])
                print(f"замечание: {note['text']}", file=sys.stderr)
        return done

    code = _decide(a, act, lambda r: f"Документ принят: {r['path']}" + ("" if r["indexed"] else ". В индекс он попадёт следующим разбором."))
    if a.defer_index and taken:
        import inbox
        try:
            inbox.start_service()
        except inbox.InboxError as e:
            if not a.json:                          # плагин читает только ответ; человеку — замечание
                print(f"замечание: {e}", file=sys.stderr)
    return code


