    """Повторы в индексе: одно письмо из нескольких выгрузок, одинаковые вложения. Файлы корпуса не трогаются."""
    import ingest
    lancedb = ingest.require_lancedb()                    # нет библиотеки индекса — отказ с кодом раньше всего остального
    import known
    if known.Known().info() is None:
        raise auth.AuthError(messages.make("cli.known_for_dedupe"))
    import dedupe_index
    index_dir = os.path.join(tokens.HOME, "index")
    table = lancedb.connect(os.path.join(index_dir, "lance")).open_table("docs")
    counts, dates = dedupe_index.index_meta(table)
    plan = dedupe_index.plan(counts, known.DB, dates=dates)
    rows = sum(counts[p] for p in plan.drop)
    total = sum(counts.values())
    print(f"В индексе фрагментов: {total}, путей: {len(counts)}")
    print(f"Повторы: убрать путей: {len(plan.drop)} (писем {plan.letters}, файлов почты {plan.files}, "
          f"двойная запись {plan.same_file}), фрагментов: {rows}")
    print(f"Вне почты, не трогается: {plan.outside} путей. Нет в корпусе: {plan.unknown} путей.")
    if not plan.drop:
        print("Повторов нет, чистить нечего.")
        return
    if not a.apply:
        print("Ничего не изменено. Чтобы убрать повторы из индекса, добавь ключ --apply")
        return
    listing = os.path.join(index_dir, "dedupe-dropped-" + time.strftime("%Y-%m-%d-%H%M%S") + ".txt")
    with os.fdopen(os.open(listing, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w", encoding="utf-8") as f:       # права — при создании, не по маске
        f.write("\n".join(plan.drop) + ("\n" if plan.drop else ""))
    deleted = dedupe_index.apply(table, plan.drop,
                                 progress=lambda n, of: print(f"убрано путей: {n} из {of}", file=sys.stderr, flush=True))
    print(f"Готово: удалено фрагментов: {deleted}, осталось: {table.count_rows()}")
    print(f"Список убранных путей: {listing}")


