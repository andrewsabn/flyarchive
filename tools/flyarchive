    cn.add_argument("harness", choices=("claude", "codex", "opencode", "dsh", "generic"), help="оболочка")
    cn.add_argument("--remote", action="store_true", help="оболочка на другой машине tailnet: адрес шлюза")
    cn.add_argument("--env", default="FLYARCHIVE_TOKEN", help="имя переменной окружения с токеном (по умолчанию FLYARCHIVE_TOKEN)")
    cn.set_defaults(fn=connect_harness)

    qu = sub.add_parser("queue", help="очередь утверждения").add_subparsers(dest="action", required=True)
    qk = sub.add_parser("quarantine", help="карантин").add_subparsers(dest="action", required=True)
    dc = sub.add_parser("doc", help="документ архива").add_subparsers(dest="action", required=True)
    for group, name, fn, text, needs_path in (
            (qu, "list", queue_list, "что ждёт решения", False), (qu, "accept", queue_accept, "принять в архив", True),
            (qu, "quarantine", queue_quarantine, "отправить в карантин", True),
            (qk, "list", quarantine_list, "что лежит в карантине", False), (qk, "delete", quarantine_delete, "стереть", True),
            (qk, "return", quarantine_return, "вернуть в папку возврата, не в архив", True),
            (dc, "delete", doc_delete, "убрать документ из архива и индекса", True)):
        one = group.add_parser(name, help=text)
        if fn in (queue_accept, queue_quarantine, quarantine_return):     # от 1 до 200 путей; с --json и «--» перед ними ответ — {"results": [...]}
            one.add_argument("paths", nargs="*", metavar="путь", help="путь из списка; с --json -- путь… — до 200 путей, ответ results")
        elif needs_path:
            one.add_argument("path", help="путь из списка или из выдачи поиска")
        if fn is queue_accept:
            one.add_argument("--defer-index", action="store_true", help="не ждать индексации: долг записан, разбор запускает служба")
        one.add_argument("--json", action="store_true", help="вывод для программ")
        if fn is doc_delete:
            one.add_argument("--yes", action="store_true", help="подтверждение удаления")
        one.set_defaults(fn=fn)

