PERMS_SHOWN = 20
CODE_DIR = os.path.dirname(os.path.realpath(__file__))        # каталог, где лежит команда: код служб идёт отсюда, а проверка прав его не смотрит


def perms_code_note():
    """Чего проверка прав не охватывает: код лежит в каталоге репозитория, не в архиве, и закрыть его от записи другим нужно самому (tools/perms.py)."""
    return f"Каталог кода ({CODE_DIR}) эта проверка не смотрит: закрой его от записи другим сам — chmod -R go-w {shlex.quote(CODE_DIR)}."


def perms_check(guard, a):
    """Закрыт ли архив от других пользователей машины."""
    import perms
    total = 0
    try:
        for p in perms.scan(tokens.HOME, deep=a.deep):
            total += 1
            if total <= PERMS_SHOWN:
                print(f"  {p.path} — {p.text}")
    except perms.PermsError as e:
        raise auth.AuthError(messages.of(e))
    if not total:
        print("Права в порядке: архив закрыт от других пользователей.")
        print(perms_code_note())
        return 0
    if total > PERMS_SHOWN:
        print(f"  … и ещё {total - PERMS_SHOWN}")
    print(f"Нарушений: {total}. Исправить: flyarchive perms fix" + (" --deep" if a.deep else ""))
    return 1


def perms_fix(guard, a):
    import perms
    try:
        changed = perms.fix(tokens.HOME, deep=a.deep)
        left = sum(1 for _ in perms.scan(tokens.HOME, deep=a.deep))
    except perms.PermsError as e:
        raise auth.AuthError(messages.of(e))
    print(f"Исправлено: {changed}.")
    if left:
        print(f"Осталось нарушений: {left} — файлы другого владельца. Смотри: flyarchive perms check", file=sys.stderr)
        return 1
    print(perms_code_note())
    return 0


def run_sandboxed(guard, a):
    """Оболочка внешней модели в песочнице: архива и домашнего каталога владельца она не видит."""
    import sandbox
    command = a.command[1:] if a.command[:1] == ["--"] else a.command
    if not (1 <= len(a.name) <= 40 and all(ch.isalnum() or ch in "-_" for ch in a.name)):
        raise auth.AuthError(messages.make("cli.bad_shell_name"))
    owner_home = os.path.expanduser("~")
    started = time.time()
    try:
        code = sandbox.run(command, workdir=a.dir, archive=tokens.HOME, owner_home=owner_home,
                           state=os.path.join(SANDBOX_DIR, a.name), pass_env=a.env, ro=a.ro,
                           protected=sandbox.read_protected(tokens.HOME), umask=getattr(a, "caller_umask", -1))
    except sandbox.SandboxError as e:
        raise auth.AuthError(messages.of(e))
    guard.journal.write(server="sandbox", client=a.name, tool="run",
                        params={"cmd": os.path.basename(command[0]), "dir": os.path.realpath(a.dir)},
                        status=code, outcome="ok" if code == 0 else f"код возврата {code}",
                        ms=int((time.time() - started) * 1000))
    return code


