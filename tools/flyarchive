    box.add_argument("--name", default="default", help="имя оболочки: у каждой свой домашний каталог в песочнице")
    box.add_argument("--env", action="append", default=[], metavar="ИМЯ",
                     help="передать внутрь переменную окружения, например с токеном; можно несколько раз")
    box.add_argument("--ro", action="append", default=[], metavar="КАТАЛОГ",
                     help="показать каталог только для чтения, например с программой оболочки; можно несколько раз")
    box.add_argument("command", nargs=argparse.REMAINDER, help="команда оболочки, после --")
    box.set_defaults(fn=run_sandboxed)

    a = p.parse_args(argv)
    import doctor                                   # справка уже напечатана разбором аргументов; дальше — только на Linux (FR-107)
    unsupported = doctor.refusal()
    if unsupported:
        print(unsupported, file=sys.stderr)
        return 2
    a.dashdash = "--" in (sys.argv[1:] if argv is None else argv)            # пути после «--»: так их зовёт плагин
    if a.cmd == "token" and a.action == "add" and a.days is not None and a.days <= 0:
        p.error("--days должен быть положительным")
    a.caller_umask = perms.close_umask()          # созданное командой в архиве — только владельцу, при любой маске запустившего;
                                                  # прежняя маска нужна одной команде — run: оболочка модели работает не в архиве
    try:
        code = a.fn(auth.Guard("cli"), a)
    except messages.CodedError as e:              # отказ с кодом: токены, вход, база известного, входящие, решения, история, приёмка
        message = messages.of(e)
        if getattr(a, "json", False):             # плагин читает последнюю строку stderr: {"error": {"code", "args", "text"}}
            print(json.dumps({"error": message.to_json()}, ensure_ascii=False), file=sys.stderr)
        else:
            print(f"ошибка: {message}", file=sys.stderr)
        return 1
    return code if isinstance(code, int) else 0


if __name__ == "__main__":
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(encoding="utf-8")
    sys.exit(main())
