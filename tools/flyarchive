def vision_backfill(guard, a):
    """Старые документы корпуса без текста в индексе (картинки и PDF) — долгами «ждёт описания»; модель не зовётся, описывает их `vision run`
    или проход. Без --limit команда не работает: старое описывается только по команде владельца и порциями."""
    import inbox
    import ingest
    limit = _vision_limit(a.limit, required=True)
    ingest.require_lancedb()                              # документы без текста ищутся по индексу: нет библиотеки — отказ с кодом, а не трассировка
    r = inbox.backfill_vision(tokens.HOME, limit, source=a.source, dry_run=a.dry_run)
    if a.json:
        return emit(r)
    tail = "Пробный запуск, ничего не записано." if r["dry_run"] else f"Записано долгов описания: {r['added']}. Описать их: flyarchive vision run"
    print(f"Найдено документов без текста в индексе: {r['candidates']}; выбрано: {len(r['files'])}. {tail}")


def _preview_text(answer):
    """Описание просмотра для человека: сведения о файле и то, что в нём нашлось."""
    meta = answer.get("meta") or {}
    kind = answer["kind"]
    if kind == "rendering":
        return "Файл ещё обрабатывается другим запросом: повтори позже."
    lines = [f"Файл: {meta.get('name')} ({meta.get('type') or 'тип не определён'}), {meta.get('size')} байт, sha256 {meta.get('sha256')}"]
    if kind == "text":
        lines += [answer["text"]] + (["… текст обрезан: показаны первые знаки"] if answer["truncated"] else [])
    elif kind == "pages":
        lines.append(f"Страниц: {answer['pages']}, показано: {answer['shown']}. Страница в PNG: flyarchive preview page --area … -- путь НОМЕР")
    elif kind == "image":
        lines.append("Картинка. В PNG: flyarchive preview page --area … -- путь 1")
    elif kind == "mail":
        mail = answer["mail"]
        lines += [f"От: {mail['from'] or '—'}", f"Кому: {', '.join(mail['to']) or '—'}"]
        lines += [f"Копия: {', '.join(mail['cc'])}"] if mail["cc"] else []
        lines += [f"Дата: {mail['date'] or '—'}", f"Тема: {mail['subject'] or '—'}", "", mail["text"]]
        lines += ["… текст обрезан: показаны первые знаки"] if mail["truncated"] else []
        if mail["attachments"]:
            lines.append("Вложения (открыть: flyarchive preview show --member НОМЕР --area … -- путь):")
            for a in mail["attachments"]:
                lines.append(f"  {a['member']}. {a['name']} ({a['type']}, {a['size']} байт)" + (" — программа" if a["executable"] else ""))
    elif kind == "listing":
        lines += ["Состав архива (ничего не распаковано):"] + [f"  {row['name']}  {row['size']} байт" for row in answer["listing"]]
        lines += [f"… список обрезан: показаны первые {len(answer['listing'])} строк"] if answer["truncated"] else []
    else:
        lines.append(answer["note"]["text"])
    return "\n".join(lines)


def preview_show(guard, a):
