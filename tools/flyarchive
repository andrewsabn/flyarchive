        one.add_argument("--area", help="где лежит файл: queue, quarantine или corpus")
        for argument in positional:
            one.add_argument(argument, help="путь: очередь/<пачка>/<имя>, карантин/<пачка>/<имя> или от корня корпуса" if argument == "path"
