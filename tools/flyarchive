        if fn is preview_show:
            one.add_argument("--json", action="store_true", help="вывод для программ")
        else:
            one.set_defaults(json=True)                  # у страницы ключа нет, а отказ всегда JSON в последней строке stderr
        one.set_defaults(fn=fn)
