def search_archive(guard, a):
    """Поиск из командной строки (FR-107): тот же поиск, тот же вывод и те же отказы, что у `python3 tools/search.py` (общие search.search и search.show).
    Нет библиотеки, таблицы индекса или службы векторов — отказ с кодом без трассировки, код возврата 1; таблица и каталог индекса не заводятся."""
    import search
    try:
        hits = search.search(a.query, a.k, a.since, a.source, a.space, a.today)
    except search.SearchError as e:
        raise auth.AuthError(messages.of(e))
    except search.BadQuery as e:
        raise auth.AuthError(messages.make("generic.text", text=str(e)))
    if a.json:
        return emit({"query": a.query, "count": len(hits), "results": [
            {"score": round(score, 5), "title": r["title"], "date": r["updated"], "base": r["source"], "space": r["space"], "path": r["path"],
             "chunk": r["chunk"], "text": r["text"]} for score, r in hits]})
    search.show(hits, a.full)


def journal_tail(guard, a):
    recs = guard.journal.tail(a.n, a.client)
    if a.json:
        return emit(recs)
    if not recs:
        print("Журнал пуст.")
        return
    for r in recs:
        params = " ".join(f"{k}={v}" for k, v in r.get("params", {}).items())
        via = f" через {r['via']}" if r.get("via") else ""
        print(f"{local_time(r['ts'])}  {r['client']:<14} {r['server']:<7} {r['tool']:<16} "
              f"{r['status']}  {r['outcome']}{via}  {params}"[:240])


def check(guard, a):
    """Разбор пачки в папку. Источник не изменяется, в архив и индекс ничего не попадает."""
    import intake
    import unpack
    d = unpack.Limits()
    limits = unpack.Limits(max_bytes=int(a.max_gb * 1024 ** 3) if a.max_gb else d.max_bytes,
                           max_files=a.max_files or d.max_files, max_ratio=a.max_ratio or d.max_ratio,
                           max_depth=a.depth or d.max_depth)
    archive = None
    if not a.without_archive:
        import known
        archive = known.Known()
        info = archive.info()
        if info is None:
            raise auth.AuthError(messages.make("known.not_built"))
        print(f"Сверка с архивом: в базе файлов {info['files']}, писем {info['mail']}, собрана {info['built']}")
    llm = None
    if a.llm:
        import llm_check
        llm = llm_check.from_env(cloud=not a.no_cloud)
        spare = (f"запасная — {llm.fallback.name}, облако: текст документа уйдёт с машины" if llm.fallback
                 else "запасной нет: непроверенное пойдёт на утверждение")
        local = llm.local.name or f"недоступна ({messages.make('llm.not_configured')})"  # имя не задано: причина названа
        print(f"Проверка моделью: {local}; {spare}")

    def llm_progress(n, total):
        if n % 25 == 0 or n == total:
            print(f"моделью проверено: {n} из {total}", file=sys.stderr, flush=True)

    import inbox
    names, root_names = inbox.service_patterns(inbox.load_config(tokens.HOME))      # те же имена служебных файлов, что у разбора входящих
    try:
        result = intake.run(a.source, a.into, limits=limits, jobs=a.jobs, archive=archive,
                            llm=llm, llm_jobs=a.llm_jobs, llm_progress=llm_progress,
                            progress=lambda n: print(f"проверено файлов: {n}", file=sys.stderr, flush=True),
                            service_names=names, service_root_names=root_names)
    except intake.IntakeError as e:
        raise auth.AuthError(messages.of(e))
    print(f"Разбор закончен за {result.seconds:.0f} с.")
    for key, title in intake.TITLES.items():
        if result.counts.get(key):
            print(f"  {title}: {result.counts[key]}")
    print(f"Отчёт: {result.report_md}")
    print(f"Подробно по каждому файлу: {result.report_jsonl}")


def known_build(guard, a):
    """База известного: sha256 каждого файла корпуса, Message-ID и отпечаток каждого письма."""
    import known
    stats = known.build(jobs=a.jobs, progress=lambda n, total: print(f"прочитано {n} из {total}", file=sys.stderr, flush=True))
    print(f"База известного собрана за {stats['seconds']:.0f} с: файлов: {stats['files']}, писем: {stats['mail']}, "
          f"прочитано заново: {stats['added']}, убрано: {stats['removed']}")
    for package, count in stats["missing"].items():          # письма, ключи которых не прочитаны без библиотеки: молчаливой потери нет
        print(f"замечание: {messages.make('known.mail_not_read', count=count, package=package)}", file=sys.stderr)


