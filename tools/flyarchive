def _forget_vision(deleted, a):
    """Документ убран из архива: строки индекса review уже убрал (фрагменты описания — те же строки по path), здесь — файл описания и долги описания.
    Описание остаётся, если то же содержимое лежит в корпусе под другим путём. Сбой не отменяет удаления: он называется в stderr."""
    import gate
    import inbox
    import known
    home = tokens.HOME
    try:
        sha = gate.sha256_of(os.path.join(home, *deleted["moved_to"].split("/")))
        twin = known.Known(os.path.join(home, "index", "known.sqlite")).find(sha256=sha)
        inbox.forget_vision(home, sha, rel=a.path.replace("\\", "/"), keep=twin is not None)
    except Exception as e:
        if not getattr(a, "json", False):
            print(f"замечание: файл описания не убран ({type(e).__name__})", file=sys.stderr)


