def inbox_set(guard, a):
    """Настройка входящих: папка, период разбора, проверка моделью. Без ключей — применить текущую заново."""
    import inbox
    home = tokens.HOME
    cfg = inbox.load_config(home)
    old = cfg["inbox"]
    new = os.path.abspath(os.path.expanduser(a.path)) if a.path else old
    must_exist = getattr(a, "must_exist", False)     # прежние вызовы без этого ключа работают как раньше
    watched = must_exist and bool(a.path)         # смена папки из плагина идёт в журнал обращений: старый и новый адрес

    def refused(e):
        if watched:
            audit(guard, "inbox set", {"old": old, "new": new}, e)
        return auth.AuthError(messages.of(e))

    if a.path:
        if must_exist:                            # каталога нет — отказ: ничего не создано, настройка и таймер не тронуты
            try:
                inbox.require_folder(new)
            except inbox.InboxError as e:
                raise refused(e)
        cfg["inbox"] = new
    if a.period is not None:
        cfg["period"] = a.period
    if a.llm is not None:
        cfg["llm"] = _switch(a.llm, "llm")
    if a.cloud is not None:
        cfg["cloud"] = _switch(a.cloud, "cloud")
    if getattr(a, "vision", None) is not None:
        cfg["vision"] = _switch(a.vision, "vision")
    for key, value in (("threshold", a.threshold), ("max_gb", a.max_gb), ("max_files", a.max_files),
                       ("max_ratio", a.max_ratio), ("depth", a.depth), ("vision_pages", getattr(a, "vision_pages", None)),
                       ("vision_minutes", getattr(a, "vision_minutes", None))):
        if value is not None:
            cfg[key] = int(value) if key == "max_gb" and float(value).is_integer() else value
    for key, given in (("service_names", getattr(a, "service_name", None)), ("service_root_names", getattr(a, "service_root_name", None))):
        if given is not None:                     # ключ задан — список заменяется целиком; пустое значение очищает его
            cfg[key] = [value.strip() for value in given if value.strip()]
    if getattr(a, "service_fate", None) is not None:        # return или delete; негодное значение отклоняет check_config
        cfg["service_fate"] = a.service_fate
    try:
        inbox.save_config(home, cfg)
    except inbox.InboxError as e:
        raise refused(e)
    if watched and new != old:
        audit(guard, "inbox set", {"old": old, "new": new})
    skip_timer = getattr(a, "no_timer", False)       # человек «только пробует»: настройки сохранены, таймер не ставится и systemd не зовётся
    trouble = None if skip_timer else inbox.install_timer(home, cfg["period"])
    if getattr(a, "json", False):
        return emit({**cfg, "vision": inbox.vision_wanted(cfg), "timer_error": trouble.to_json() if trouble else None,
                     **({"timer_skipped": True} if skip_timer else {})})
    print(f"Входящая папка: {cfg['inbox']}")
    when = f"Разбор — вручную; период {cfg['period']} мин записан на будущее." if skip_timer else f"Разбор каждые {cfg['period']} мин."
    print(f"{when} Проверка моделью: {'да' if cfg['llm'] else 'нет'}; "
          f"запасная облачная модель: {'да' if cfg['llm'] and cfg['cloud'] else 'нет'}.")
    print(f"Описание изображений: {'да' if inbox.vision_wanted(cfg) else 'нет'} (картинки и сканы без текста, только локальная модель; "
          f"за проход до {cfg['vision_pages']} страниц и {cfg['vision_minutes']} минут).")
    print(f"Порог {cfg['threshold']} баллов. Пределы архива: {cfg['max_gb']} ГБ, {cfg['max_files']} файлов, "
          f"сжатие {cfg['max_ratio']} к 1, вложенность {cfg['depth']}.")
    print(_service_line(cfg))
    print(_fate_line(cfg))
    if skip_timer:
        print(messages.make("inbox.timer_skipped"))
    if trouble:
        print(f"Таймер не включён: {trouble}", file=sys.stderr)


def inbox_run(guard, a):
    """Один проход по входящей папке — то же, что делает таймер."""
    import inbox
    import intake
    home = tokens.HOME
    cfg = inbox.load_config(home)
    checker = None
    if cfg["llm"]:
        import llm_check
        checker = llm_check.from_env(cloud=cfg["cloud"])
    describer = None
    if inbox.vision_wanted(cfg):                    # описание картинок: только локальная модель, облачная точка здесь не собирается вовсе
        import vision
        describer = vision.from_env()

    names, root_names = inbox.service_patterns(cfg)

    def once():
        return inbox.process(home, cfg["inbox"], checker=checker, stable_seconds=cfg["stable_seconds"],
                             jobs=min(8, os.cpu_count() or 1), threshold=cfg["threshold"], limits=inbox.limits_of(cfg),
                             vision=describer, vision_pages=cfg["vision_pages"], vision_minutes=cfg["vision_minutes"],
                             service_names=names, service_root_names=root_names, service_fate=inbox.service_fate(cfg))

    try:
        s = once()
        if s.batch is None and a.wait and inbox.status(home)["waiting"]:
            time.sleep(cfg["stable_seconds"] + 1)           # только что положенный файл должен отстояться
            s = once()
    except inbox.Busy:
        print("Разбор входящих уже идёт — этот запуск пропущен.")
        return 0
    except inbox.InboxError as e:
        raise auth.AuthError(messages.of(e))
    for p in s.problems:
        print(f"замечание: {p}", file=sys.stderr)
    if s.batch is None:
        print("Разбирать нечего: во входящей папке нет файлов, которые перестали меняться.")
        return 0
    print(f"Пачка {s.batch}:")
    for key, title in intake.TITLES.items():
        if s.counts.get(key):
            print(f"  {title}: {s.counts[key]}")
    print(f"Квитанции: {s.receipts}")
    return 0


