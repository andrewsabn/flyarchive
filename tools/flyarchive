        dest="action", required=True)
    for name, fn, text, positional in (("show", preview_show, "что в файле: вид, сведения, текст или число страниц", ("path",)),
                                       ("page", preview_page, "страница в PNG в stdout", ("path", "number"))):
        one = pv.add_parser(name, help=text)
        one.add_argument("--member", action="append", default=[], metavar="N",
